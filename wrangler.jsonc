{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "schaakwoude",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "schaakwoude",
			"database_id": "ebcf7ff8-d2b0-44c0-beec-2966cb0dc2aa",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "schaakwoude-media",
		},
	],
	// Gepland publiceren en onderhoud. Elke 5 minuten is genoeg en past ruim
	// binnen het gratis plan (100.000 verzoeken per dag).
	"triggers": {
		"crons": ["*/5 * * * *"],
	},
}
