{
 "$schema": "https://emdashcms.com/seed.schema.json",
 "version": "1",
 "meta": {
  "name": "Schaakwoude",
  "description": "Website van Schaakvereniging Schaakwoude in Damwâld",
  "author": "Schaakvereniging Schaakwoude"
 },
 "settings": {
  "title": "Schaakwoude",
  "tagline": "Waar passie voor schaken en gezelligheid samenkomen",
  "postsPerPage": 12,
  "timezone": "Europe/Amsterdam",
  "dateFormat": "d MMMM yyyy"
 },
 "collections": [
  {
   "slug": "posts",
   "label": "Nieuws",
   "labelSingular": "Bericht",
   "urlPattern": "/nieuws/{slug}",
   "supports": [
    "drafts",
    "revisions",
    "preview",
    "scheduling",
    "search",
    "seo"
   ],
   "fields": [
    {
     "slug": "title",
     "label": "Titel",
     "type": "string",
     "required": true,
     "searchable": true
    },
    {
     "slug": "excerpt",
     "label": "Samenvatting",
     "type": "text",
     "searchable": true
    },
    {
     "slug": "featured_image",
     "label": "Afbeelding bovenaan",
     "type": "image"
    },
    {
     "slug": "content",
     "label": "Tekst",
     "type": "portableText",
     "searchable": true
    }
   ]
  },
  {
   "slug": "pages",
   "label": "Pagina's",
   "labelSingular": "Pagina",
   "urlPattern": "/{slug}",
   "supports": [
    "drafts",
    "revisions",
    "preview",
    "search",
    "seo"
   ],
   "fields": [
    {
     "slug": "title",
     "label": "Titel",
     "type": "string",
     "required": true,
     "searchable": true
    },
    {
     "slug": "intro",
     "label": "Inleiding",
     "type": "text"
    },
    {
     "slug": "content",
     "label": "Tekst",
     "type": "portableText",
     "searchable": true
    }
   ]
  },
  {
   "slug": "agenda",
   "label": "Agenda",
   "labelSingular": "Activiteit",
   "urlPattern": "/agenda#{slug}",
   "supports": [
    "drafts",
    "search"
   ],
   "fields": [
    {
     "slug": "title",
     "label": "Wat",
     "type": "string",
     "required": true,
     "searchable": true
    },
    {
     "slug": "begin",
     "label": "Begint",
     "type": "datetime",
     "required": true,
     "indexed": true
    },
    {
     "slug": "eind",
     "label": "Eindigt",
     "type": "datetime"
    },
    {
     "slug": "hele_dag",
     "label": "Hele dag (geen tijd tonen)",
     "type": "boolean"
    },
    {
     "slug": "soort",
     "label": "Soort",
     "type": "select",
     "required": true,
     "defaultValue": "Clubavond",
     "validation": {
      "options": [
       "Clubavond",
       "Interne competitie",
       "Jeugd",
       "KNSB",
       "FSB",
       "Toernooi",
       "Club",
       "Vergadering",
       "Vakantie"
      ]
     }
    },
    {
     "slug": "locatie",
     "label": "Waar",
     "type": "string"
    },
    {
     "slug": "omschrijving",
     "label": "Toelichting",
     "type": "text"
    },
    {
     "slug": "link",
     "label": "Meer informatie (link)",
     "type": "string"
    },
    {
     "slug": "uitgelicht",
     "label": "Uitlichten op de voorpagina",
     "type": "boolean"
    }
   ]
  },
  {
   "slug": "teams",
   "label": "Teams",
