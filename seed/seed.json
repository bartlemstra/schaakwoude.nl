     "type": "string",
     "searchable": true
    },
    {
     "slug": "snelschaak",
     "label": "Snelschaakkampioen",
     "type": "string",
     "searchable": true
    },
    {
     "slug": "zomer",
     "label": "Zomercompetitie",
     "type": "string",
     "searchable": true
    },
    {
     "slug": "jeugd",
     "label": "Jeugdkampioen",
     "type": "string",
     "searchable": true
    }
   ]
  },
  {
   "slug": "ereleden",
   "label": "Ereleden",
   "labelSingular": "Erelid",
   "urlPattern": "/eregalerij#{slug}",
   "fields": [
    {
     "slug": "title",
     "label": "Naam",
     "type": "string",
     "required": true,
     "searchable": true
    },
    {
     "slug": "eretitel",
     "label": "Titel",
     "type": "string",
     "required": true
    },
    {
     "slug": "sinds",
     "label": "Sinds (jaar)",
     "type": "integer"
    }
   ]
  }
 ],
