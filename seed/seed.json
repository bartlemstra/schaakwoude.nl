   "supports": [
    "drafts"
   ],
   "fields": [
    {
     "slug": "title",
     "label": "Teamnaam",
     "type": "string",
     "required": true,
     "searchable": true
    },
    {
     "slug": "bond",
     "label": "Bond",
     "type": "select",
     "required": true,
     "validation": {
      "options": [
       "KNSB",
       "FSB"
      ]
     }
    },
    {
     "slug": "klasse",
     "label": "Klasse",
     "type": "string"
    },
    {
     "slug": "teamleider",
     "label": "Teamleider",
     "type": "string"
    },
    {
     "slug": "spelers",
     "label": "Spelers",
     "type": "repeater",
     "validation": {
      "subFields": [
       {
        "slug": "naam",
        "label": "Naam",
        "type": "string",
        "required": true
       }
      ],
      "maxItems": 20
     }
    },
    {
     "slug": "netstand_url",
     "label": "Uitslagen en stand (netstand-link)",
     "type": "url"
    },
    {
     "slug": "volgorde",
     "label": "Volgorde",
     "type": "integer"
    },
    {
     "slug": "content",
     "label": "Toelichting",
     "type": "portableText"
    }
   ]
  },
  {
   "slug": "sponsors",
   "label": "Sponsors",
   "labelSingular": "Sponsor",
   "urlPattern": "/sponsors#{slug}",
   "supports": [
    "drafts"
   ],
   "fields": [
    {
     "slug": "title",
     "label": "Naam",
     "type": "string",
     "required": true,
     "searchable": true
    },
    {
     "slug": "logo",
     "label": "Logo",
     "type": "image"
    },
    {
     "slug": "website",
     "label": "Website",
     "type": "url"
    },
    {
     "slug": "niveau",
     "label": "Soort",
     "type": "select",
     "required": true,
     "defaultValue": "Sponsor",
     "validation": {
      "options": [
       "Hoofdsponsor",
       "Sponsor",
       "Vriend van de club"
      ]
     }
    },
    {
     "slug": "volgorde",
     "label": "Volgorde",
     "type": "integer"
    }
   ]
  },
  {
   "slug": "eregalerij",
   "label": "Eregalerij",
   "labelSingular": "Seizoen",
   "urlPattern": "/eregalerij#{slug}",
   "supports": [
    "search"
   ],
   "fields": [
    {
     "slug": "title",
     "label": "Seizoen (bijv. 2025/2026)",
     "type": "string",
     "required": true,
     "searchable": true
    },
    {
     "slug": "intern_1",
     "label": "Clubkampioen",
     "type": "string",
     "searchable": true
    },
    {
     "slug": "intern_2",
     "label": "Interne competitie, 2e",
