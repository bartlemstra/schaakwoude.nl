		<rect x="13" y="13" width="7" height="7" rx="1.5" /><rect x="27" y="13" width="7" height="7" rx="1.5" />
		<rect x="6" y="20" width="7" height="7" rx="1.5" /><rect x="20" y="20" width="7" height="7" rx="1.5" />
	</g>
	<path d="M27 34c-3.4-2.6-6-4.8-6-7.6a3.1 3.1 0 0 1 6-1.2 3.1 3.1 0 0 1 6 1.2c0 2.8-2.6 5-6 7.6z" fill="var(--accent-2)" />
