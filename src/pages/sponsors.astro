---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";

const sponsors = await getEmDashCollection("sponsors", { orderBy: { volgorde: "asc" }, limit: 100 });
if (Astro.cache?.enabled) Astro.cache.set(sponsors.cacheHint);
const groepen = ["Hoofdsponsor", "Sponsor", "Vriend van de club"].map((n) => ({ naam: n, lijst: sponsors.entries.filter((s) => s.data.niveau === n) }));
---
<Base title="Sponsors" description="De sponsors van Schaakvereniging Schaakwoude.">
	<div class="wrap">
		<header class="paginakop">
			<p class="oogje">Met dank aan</p>
			<h1>Sponsors</h1>
			<p class="lead">Dankzij deze ondernemers uit de regio kan Schaakwoude jeugdlessen, toernooien en de simultaan organiseren.</p>
		</header>
		<div class="stapel" style="gap:2.5rem">
			{groepen.filter((g) => g.lijst.length).map((g) => (
				<section class="stapel">
					<h2>{g.naam === "Sponsor" ? "Sponsors" : g.naam}</h2>
					<ul class="sponsorstrook" style={g.naam === "Hoofdsponsor" ? "grid-template-columns:repeat(auto-fill,minmax(260px,1fr))" : undefined}>
						{g.lijst.map((s) => {
							const inhoud = s.data.logo?.src ? <img src={s.data.logo.src} alt={s.data.title} loading="lazy" /> : s.data.title;
							return <li>{s.data.website ? <a href={s.data.website} rel="noopener sponsored">{inhoud}</a> : <span>{inhoud}</span>}</li>;
						})}
					</ul>
				</section>
			))}
			<section class="paneel stapel">
				<h2 style="font-size:1.4rem">Sponsor worden?</h2>
				<p>Een logo op de site, een bord in de speelzaal of een toernooi op uw naam: neem contact op met de penningmeester. <span class="notitie">Bedragen en pakketten vult het bestuur nog in</span></p>
			</section>
		</div>
	</div>
</Base>
