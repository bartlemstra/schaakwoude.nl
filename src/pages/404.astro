---
import Base from "../layouts/Base.astro";
Astro.response.status = 404;
---
<Base title="Niet gevonden">
	<div class="wrap smal" style="margin-inline:auto">
		<header class="paginakop">
			<p class="oogje">Fout 404</p>
			<h1>Deze zet bestaat niet.</h1>
			<p class="lead">De pagina is verplaatst of bestaat niet meer. Misschien staat hij in het archief.</p>
			<div class="knoppen"><a class="knop" href="/zoeken">Zoek in het archief</a><a class="knop knop--rand" href="/">Naar de voorpagina</a></div>
		</header>
	</div>
</Base>
